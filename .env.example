# GEMINI_API_KEY: Required for Gemini 4 API calls (gemini-decision-1, gemini-4-neon, gemini-omni-1.2-flash, gemini-embedding-2).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: 3000 in local dev / AI Studio preview; 8080 on Google Cloud Run.
PORT="3000"

# ------------------------------------------------------------------------------
# Google Cloud SQL (PostgreSQL 16 + pgvector) — Object Method Pool Config
# Instance: gemini4nyc26nyc-2273:us-east1:free-trial-first-project
# ------------------------------------------------------------------------------
# Cloud Run automatically sets K_SERVICE and mounts the Auth Proxy Unix socket at:
#   /cloudsql/gemini4nyc26nyc-2273:us-east1:free-trial-first-project
# Outside Cloud Run, the backend connects over TLS to SQL_PUBLIC_IP:SQL_PORT.
SQL_CONNECTION_NAME="gemini4nyc26nyc-2273:us-east1:free-trial-first-project"
SQL_PUBLIC_IP="34.74.102.222"
SQL_OUTGOING_IP="34.73.184.213"
SQL_PORT="5432"

# Optional override: leave blank to auto-select Unix socket on Cloud Run or SQL_PUBLIC_IP elsewhere.
# Set to "127.0.0.1" if running cloud-sql-proxy locally, or "/cloudsql/..." explicitly.
SQL_HOST=""

# TLS for direct TCP connections to SQL_PUBLIC_IP (automatically disabled on /cloudsql/ Unix sockets).
SQL_SSL="true"
# Optional: PEM-encoded server CA certificate from Cloud SQL Console for strict cert verification.
# SQL_SSL_CA=""

# Database credentials (inject via AI Studio Secrets or Google Secret Manager — NEVER commit real values)
SQL_DB_NAME="jackofalltrades"
SQL_USER="joat_app"
SQL_PASSWORD="CHANGE_ME_IN_SECRET_MANAGER"
