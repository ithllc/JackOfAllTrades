# GEMINI_API_KEY: Required for Gemini 4 API calls (gemini-decision-1, gemini-4-neon, gemini-omni-1.2-flash, gemini-embedding-2).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: 3000 in local dev / AI Studio preview; 8080 on Google Cloud Run.
PORT="3000"

# ------------------------------------------------------------------------------
# Google Cloud SQL (PostgreSQL 16 + pgvector) — Object Method Pool Config
# Instance: gemini4nyc26nyc-2273:us-east1:free-trial-first-project
# Supports either DB_* (DB_HOST, DB_NAME, DB_USER, DB_PASS) or SQL_* variables.
# ------------------------------------------------------------------------------
SQL_CONNECTION_NAME="gemini4nyc26nyc-2273:us-east1:free-trial-first-project"
SQL_PUBLIC_IP="34.74.102.222"
SQL_OUTGOING_IP="34.73.184.213"
SQL_PORT="5432"

# On Cloud Run with --add-cloudsql-instances, set DB_HOST (or SQL_HOST) to:
#   /cloudsql/gemini4nyc26nyc-2273:us-east1:free-trial-first-project
# Outside Cloud Run, leave blank to connect via SQL_PUBLIC_IP:5432 with TLS,
# or set to "127.0.0.1" when using local cloud-sql-proxy.
DB_HOST=""
DB_NAME="postgres"
DB_USER="postgres"
# NEVER commit a real password! Inject DB_PASS (or SQL_PASSWORD) via Secret Manager / Secrets.
DB_PASS="CHANGE_ME_IN_SECRET_MANAGER"

# TLS for direct TCP connections to SQL_PUBLIC_IP (automatically disabled on /cloudsql/ Unix sockets).
SQL_SSL="true"
